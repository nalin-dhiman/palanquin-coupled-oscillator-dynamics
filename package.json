{
  "name": "rath-dynamics-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live walking-informed heave, roll and pitch with four shoulder contacts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "python3 -m http.server 8080 --directory dist",
    "deploy": "node scripts/deploy.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0"
  },
  "engines": {
    "node": ">=18"
  }
}
